---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import {searchEntries} from '../data/site';
---
<Layout title="Search Gewabin" noindex><PageHero title="Search Gewabin" description="Find products, application information, services and technical resources." eyebrow="SITE SEARCH"/><section class="section wrap"><form class="site-search-form" role="search"><label for="site-query">Search the website</label><div><input id="site-query" name="q" type="search" placeholder="Enter a product, application or topic…"/><button type="submit" class="btn">Search →</button></div></form><p class="result-count" aria-live="polite"></p><div class="search-results">{searchEntries.map(entry=><a class="search-result" href={entry.href} data-site-search={(entry.title+' '+entry.description).toLowerCase()}><span class="eyebrow">{entry.type||'GEWABIN'}</span><h2>{entry.title}</h2><p>{entry.description}</p><span class="text-link">View page <span>→</span></span></a>)}</div><div class="empty-results" hidden><h2>No matching pages</h2><p>Try “condenser”, “cooling tower”, “parts” or “service”.</p><button class="btn" id="reset-site-search">Show all pages →</button></div></section><script>
 const form=document.querySelector<HTMLFormElement>('.site-search-form')!,input=document.querySelector<HTMLInputElement>('#site-query')!,results=[...document.querySelectorAll<HTMLElement>('[data-site-search]')],empty=document.querySelector<HTMLElement>('.empty-results')!;input.value=new URLSearchParams(location.search).get('q')||'';function update(){const q=input.value.trim().toLowerCase(),words=q.split(/\s+/).filter(Boolean);let n=0;results.forEach(r=>{r.hidden=!words.every(word=>r.dataset.siteSearch!.includes(word));if(!r.hidden)n++;});document.querySelector('.result-count')!.textContent=q?`${n} results for “${input.value.trim()}”`:`${n} pages — enter a keyword to narrow your search`;empty.hidden=n>0;const url=new URL(location.href);url.search='';if(input.value.trim())url.searchParams.set('q',input.value.trim());history.replaceState({},'',url);}form.addEventListener('submit',e=>{e.preventDefault();update();});input.addEventListener('input',update);document.querySelector('#reset-site-search')?.addEventListener('click',()=>{input.value='';update();input.focus();});update();
 </script></Layout>
