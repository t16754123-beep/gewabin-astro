---
import Layout from '../layouts/Layout.astro';
import ProjectInquiry from '../components/ProjectInquiry.astro';
import {company,products} from '../data/content';
import {applications} from '../data/extended';
const slides=[{image:'malaysia.jpg',title:'Industrial Refrigeration & Cooling Solutions',text:'Evaporative condensers · Closed circuit cooling towers · Custom equipment'},{image:'warehouse.jpg',title:'Cooling Equipment for Your Next Project',text:'Technical communication · Customized design · Installation support'}];
const benefits=[{symbol:'✧',title:'Engineering Support',text:'Technical communication and equipment selection for your operating conditions.'},{symbol:'⚙',title:'Flexible Customization',text:'Customized products, processing services and OEM solutions.'},{symbol:'✓',title:'Quality & Inspection',text:'Materials, coil pressure testing and equipment inspection.'}];
const steps=[{title:'Heat Exchange Coils',image:'coil.jpg',text:'Seamless steel tubing and hot-dip galvanized or stainless steel material options for heat exchange coils.',href:'/parts/condenser-coils/'},{title:'Equipment Manufacturing',image:'production.jpg',text:'Manufacturing and assembly of Gewabin refrigeration equipment at the Yixing production base.',href:'/about/factory/'},{title:'Materials & Components',image:'factory-workshop.jpg',text:'Discuss casing materials, coil construction and the components needed for your project.',href:'/parts/'},{title:'Coil Pressure Testing',image:'condenser.jpg',text:'The stainless steel evaporative condenser product specification describes three coil pressure tests.',href:'/about/quality/'},{title:'Assembly & Project Support',image:'factory.jpg',text:'Coordinate equipment requirements, installation guidance and spare-parts support with Gewabin.',href:'/services/installation-support/'}];
const order=[{title:'Share Your Project Requirements',text:'Send the application, refrigerant or process fluid, required duty, site conditions and available space.'},{title:'Technical Communication & Equipment Selection',text:'Discuss operating conditions and compare the appropriate product family with Gewabin.'},{title:'Confirm Configuration & Quotation',text:'Agree on the equipment scope, materials, dimensions, documentation and commercial terms.'},{title:'Manufacturing & Assembly',text:'Coordinate customized requirements and follow the equipment manufacturing process.'},{title:'Inspection & Testing',text:'Confirm the applicable inspection and testing requirements for the selected equipment.'},{title:'Delivery & Installation Support',text:'Discuss packing, shipment, installation guidance and spare-parts requirements with the team.'}];
const faqs=[{q:'What information helps Gewabin recommend suitable equipment?',a:'Share your application, refrigerant or process fluid, required heat-rejection duty, design conditions and site dimensions. Drawings and existing equipment details are also helpful.'},{q:'Can the equipment be customized for my project?',a:'Gewabin offers customized products, processing services and OEM solutions. Send your material, dimensional and connection requirements for a technical discussion.'},{q:'Which product family should I choose?',a:'Evaporative condensers condense refrigerant inside the coil. Closed circuit cooling towers cool a process fluid in a separate closed loop. Use our product family selector to prepare your inquiry.'},{q:'Are installation guidance and after-sales support available?',a:'Gewabin describes installation guidance, commissioning communication and spare-parts support in its service offering. Contact the team with your order and equipment details.'},{q:'How do I confirm delivery time and warranty terms?',a:'Delivery and warranty terms depend on the selected equipment and order agreement. Request a written quotation from Gewabin for your project.'},{q:'How do I send drawings or project documents?',a:'Use the form to prepare an email, then attach your drawings in your email app before sending. You can also email '+company.email+' directly.'}];
---
<Layout title="Industrial Cooling & Refrigeration Equipment">
 <section class="cht-hero" aria-label="Featured cooling solutions" aria-roledescription="carousel">
  {slides.map((slide,i)=><article class="cht-hero-slide" data-slide hidden={i!==0} aria-label={`${i+1} of ${slides.length}`}><img class="cht-hero-image" src={'/images/'+slide.image} alt={i===0?'Gewabin evaporative condenser installed at an ice-making project in Malaysia':'Gewabin condenser for a fruit preservation warehouse'} width="1440" height="850" fetchpriority={i===0?'high':'auto'}/><div class="cht-hero-shade"></div><div class="cht-hero-copy wrap">{i===0?<h1>{slide.title}</h1>:<h2>{slide.title}</h2>}<p>{slide.text}</p><a class="btn white" href="#technical-team">Send Your Inquiry Now</a></div></article>)}
  <button class="cht-hero-arrow slide-prev" aria-label="Previous slide">‹</button><button class="cht-hero-arrow slide-next" aria-label="Next slide">›</button><div class="cht-hero-controls">{slides.map((slide,i)=><button data-dot={i} aria-label={`Show slide ${i+1}`} aria-pressed={i===0}></button>)}<button class="slide-pause" aria-label="Pause slideshow" aria-pressed="false">Ⅱ</button></div>
 </section>
 <section class="cht-benefits wrap" aria-label="Gewabin services">{benefits.map(b=><article><span class="cht-line-icon" aria-hidden="true">{b.symbol}</span><div><h2>{b.title}</h2><p>{b.text}</p></div></article>)}</section>
 <section class="cht-company section wrap"><div class="cht-company-photo"><img src="/images/factory.jpg" alt="Gewabin manufacturing base in Yixing" width="680" height="500" loading="lazy"/></div><div><h2>Customized Industrial Cooling Solution Provider</h2><p>{company.intro}</p><p>{company.about}</p><p>{company.philosophy}</p><a class="text-link" href="/about/">Read More →</a><br/><a class="btn" href="/services/technical-consultation/">Contact Our Support Team</a></div></section>
 <section class="cht-stats wrap" aria-label="Gewabin at a glance"><div><strong>2017</strong><span>Company established</span></div><div><strong>15,000 m²</strong><span>Production base</span></div><div><strong>3</strong><span>Core product families</span></div><div><strong>OEM</strong><span>Custom equipment & services</span></div></section>
 <section class="cht-product-section section"><div class="wrap"><div class="cht-section-heading"><div><h2>Industrial Cooling Products</h2><p>Evaporative condensers, closed circuit cooling towers and refrigeration heat exchanger components for your project.</p></div><a class="btn" href="/products/">Learn More</a></div><div class="cht-home-products">{products.map(p=><a class="cht-product-card" href={'/products/'+p.slug+'/'}><div class="cht-product-photo"><img src={'/images/'+p.image} alt={p.name} width="400" height="330" loading="lazy"/></div><h3>{p.name}</h3><p>{p.description}</p><span class="cht-explore">Explore More →</span></a>)}</div></div></section>
 <section class="section wrap cht-standout"><h2>What Makes Our Cooling Equipment Stand Out</h2><p>Product construction and project support from Gewabin’s refrigeration equipment range.</p><div class="cht-four-features">{[{icon:'✓',title:'Coil Construction',text:'Galvanized steel and stainless steel coil options.'},{icon:'◇',title:'Closed Circuit Design',text:'Process fluid remains inside the heat exchange coil.'},{icon:'⚙',title:'Customized Equipment',text:'Discuss materials and configuration for your project.'},{icon:'☏',title:'Technical Support',text:'Consultation, installation guidance and spare parts.'}].map(b=><article><span class="cht-line-icon" aria-hidden="true">{b.icon}</span><h3>{b.title}</h3><p>{b.text}</p></article>)}</div></section>
 <section class="section wrap cht-production"><h2>Manufacturing & Inspection Process</h2><p>Explore Gewabin’s heat exchange components, manufacturing base and equipment testing information.</p><div class="cht-process-panels">{steps.map((step,i)=><article class:list={['cht-process-panel',{active:i===0}]}><img src={'/images/'+step.image} alt={step.title} width="680" height="600" loading="lazy"/><button class="cht-process-toggle" aria-expanded={i===0}><span>{step.title}</span><span aria-hidden="true">+</span></button><div class="cht-process-copy"><h3>{step.title}</h3><p>{step.text}</p><a class="btn white" href={step.href}>Learn More →</a></div></article>)}</div></section>
 <section class="section wrap cht-feature"><a class="cht-feature-photo" href="/services/technical-consultation/"><img src="/images/factory-workshop.jpg" alt="Gewabin workshop and manufacturing equipment" width="680" height="500" loading="lazy"/></a><div><h2>Technical Communication & Custom Cooling Solutions</h2><p>Gewabin’s technical team discusses your operating conditions and equipment requirements before the order. Share your application, required duty, available space and preferred materials.</p><p>Customized equipment, processing services and OEM solutions are available for project-specific needs.</p><a class="btn" href="/services/customization/">Explore Customization Services</a></div></section>
 <section class="section wrap cht-feature reverse"><a class="cht-feature-photo" href="/about/quality/"><img src="/images/production.jpg" alt="Gewabin refrigeration equipment production" width="680" height="500" loading="lazy"/></a><div><h2>Product Construction & Quality Inspection</h2><p>Review the coil materials, fans, fill and drift eliminators used in Gewabin equipment. Product specifications describe construction details and the applicable coil pressure tests.</p><p>Confirm project inspection requirements, materials and documentation with the technical team before ordering.</p><a class="btn" href="/about/quality/">Explore Quality Information</a></div></section>
 <section class="cht-industries section"><div class="wrap"><div class="cht-section-heading"><h2>Meet Diverse Industry Requirements</h2><p>Explore the cooling application, then discuss a configuration matched to your operating conditions.</p></div><div class="cht-industry-grid">{applications.filter(a=>a.slug!=='building-hvac').map(a=><a href={'/applications/'+a.slug+'/'}><img src={'/images/'+a.image} alt={a.title} width="400" height="260" loading="lazy"/><h3>{a.title}</h3><p>{a.description}</p><span class="cht-explore">Learn More →</span></a>)}</div><div class="cht-more-applications"><strong>More Application Support</strong><a href="/applications/building-hvac/">Building & HVAC</a><a href="/applications/industrial-process-cooling/">Chemical Processing</a><a href="/applications/industrial-process-cooling/">Power Generation</a><a href="/applications/food-and-beverage/">Ice Making</a></div></div></section>
 <section class="section wrap cht-order"><div><h2>From Your First Inquiry to Project Support</h2><p>Start with a clear equipment brief. Gewabin provides technical communication, customization and support for your refrigeration and cooling project.</p><a class="text-link" href="/tools/product-selector/">Find your product family →</a></div><div class="cht-order-steps">{order.map((step,i)=><details open={i===0}><summary><span>{String(i+1).padStart(2,'0')}</span>{step.title}</summary><p>{step.text}</p></details>)}</div></section>
 <section class="cht-faq-section section" id="faq"><div class="wrap cht-faq-layout"><ProjectInquiry compact title="Quick Quote"/><div class="cht-faq"><h2>FAQ</h2><p>Common questions about Gewabin equipment, customization and project inquiries. Contact our team if you need more details.</p>{faqs.map((f,i)=><details open={i===0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
 <section class="section wrap cht-resources"><h2>Resource Center</h2><p>Product information, official videos and cooling guides to support your next equipment discussion.</p><div>{[{title:'Product Information',text:'Browse construction details, features and published product specifications.',href:'/products/',icon:'▤'},{title:'Video Center',text:'Gewabin factory, workshop and equipment videos from the official channel.',href:'/library/videos/',icon:'▷'},{title:'Knowledge Center',text:'Cooling fundamentals, components, maintenance and industry applications.',href:'/library/',icon:'▧'}].map(r=><a href={r.href}><span aria-hidden="true">{r.icon}</span><h3>{r.title}</h3><p>{r.text}</p><b aria-hidden="true">→</b></a>)}</div></section>
 <section class="section wrap cht-contact-section" id="technical-team"><h2>Contact Our Technical Team</h2><p>Leave your project details and discuss an industrial cooling solution with Gewabin.</p><ProjectInquiry title=""/></section>
 <script>
 const slides=[...document.querySelectorAll<HTMLElement>('[data-slide]')],dots=[...document.querySelectorAll<HTMLButtonElement>('[data-dot]')];let current=0,paused=matchMedia('(prefers-reduced-motion: reduce)').matches;const pause=document.querySelector<HTMLButtonElement>('.slide-pause');
 function show(n:number){current=(n+slides.length)%slides.length;slides.forEach((s,i)=>s.hidden=i!==current);dots.forEach((d,i)=>d.setAttribute('aria-pressed',String(i===current)));}
 function updatePause(){pause?.setAttribute('aria-pressed',String(paused));pause?.setAttribute('aria-label',paused?'Play slideshow':'Pause slideshow');if(pause)pause.textContent=paused?'▷':'Ⅱ';}
 dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);paused=true;updatePause();}));document.querySelector('.slide-prev')?.addEventListener('click',()=>{show(current-1);paused=true;updatePause();});document.querySelector('.slide-next')?.addEventListener('click',()=>{show(current+1);paused=true;updatePause();});pause?.addEventListener('click',()=>{paused=!paused;updatePause();});setInterval(()=>{if(!paused&&!document.hidden&&!document.querySelector('.cht-hero')?.matches(':hover, :focus-within'))show(current+1);},7000);updatePause();
 document.querySelectorAll<HTMLButtonElement>('.cht-process-toggle').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('.cht-process-panel').forEach(panel=>{const active=panel===button.closest('.cht-process-panel');panel.classList.toggle('active',active);panel.querySelector('button')?.setAttribute('aria-expanded',String(active));});}));
 </script>
</Layout>
