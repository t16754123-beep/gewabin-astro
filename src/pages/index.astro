---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import {company,stories} from '../data/content';
const slides=[
 {title:'Evaporative Condenser',text:'Cross flow and counter flow evaporative condensers.',image:'counter-flow.jpg',background:'warehouse.jpg',href:'/products/?category=condensers',cta:'Explore Evaporative Condensers'},
 {title:'Closed Circuit Cooling Tower',text:'Cross flow and counter flow cooling towers.',image:'industrial.jpg',background:'malaysia.jpg',href:'/products/?category=towers',cta:'Find Your Cooling Tower'},
 {title:'Refrigeration Heat Exchanger Parts',text:'Condenser coils, PVC fill and drift eliminators.',image:'parts-category.jpg',background:'factory.jpg',href:'/products/?category=parts',cta:'Explore Heat Exchanger Parts'},
];
---
<Layout>
 <section class="spx-hero" aria-label="Featured cooling products" aria-roledescription="carousel">
  {slides.map((s,i)=><article class="spx-slide" data-slide hidden={i!==0} style={`--slide-bg:url('/images/${s.background}')`} aria-label={`${i+1} of 3`}><div class="spx-slide-inner"><div class="spx-slide-image"><img src={'/images/'+s.image} alt={s.title} width="600" height="450" fetchpriority={i===0?'high':'auto'}/></div><div class="spx-slide-description"><h1>{s.title}</h1><p>{s.text}</p><a href={s.href} class="spx-slide-button">{s.cta}</a></div></div></article>)}
  <button class="spx-arrow slide-prev" aria-label="Previous slide">‹</button><button class="spx-arrow slide-next" aria-label="Next slide">›</button><div class="spx-carousel-controls">{slides.map((s,i)=><button data-dot={i} aria-label={`Show ${s.title}`} aria-pressed={i===0}></button>)}<button class="slide-pause" aria-label="Pause slideshow" aria-pressed="false">Ⅱ</button></div>
 </section>
 <section class="spx-intro wrap"><div class="spx-intro-card"><div class="spx-company-copy"><h2>Jiangsu Gewabin Heat Technology</h2><p>{company.intro}</p><p>{company.about}</p><p>{company.philosophy}</p><a href="/about/">Learn more about Jiangsu Gewabin Heat Technology</a></div><a href="/about/" class="spx-company-image"><img src="/images/factory.jpg" alt="Gewabin factory in Yixing, China" width="680" height="500"/></a></div></section>
 <section class="spx-video-section wrap"><h2>Evaporative Condensers and Closed Circuit Cooling Towers</h2><p>Gewabin factory and workshop</p><div class="spx-video" id="factory-video"><img class="spx-video-poster" src="/images/production.jpg" alt="Gewabin refrigeration equipment manufacturing" width="1296" height="729" loading="lazy"/><div class="spx-video-shade"></div><button class="spx-play" aria-label="Play Gewabin factory and workshop video"><svg width="54" height="60" viewBox="0 0 54 60" aria-hidden="true"><path d="M5 4 50 30 5 56Z" fill="white"/></svg></button><img class="video-logo" src="/images/gewabin-logo.png" alt="Gewabin" width="200" height="100" loading="lazy"/></div><p class="video-fallback" hidden>Video unavailable? <a href="https://www.youtube.com/watch?v=4irPZt6UlNA" target="_blank" rel="noopener noreferrer">Watch Gewabin factory and workshop on YouTube ↗</a></p></section>
 <section class="spx-news wrap" id="news"><h2><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="4" width="16" height="17" rx="1"/><path d="M5 7H2v12a2 2 0 0 0 2 2M8 8h10M8 12h4v5H8zM15 12h3M15 16h3"/></svg> Gewabin News</h2><div class="news-grid">{stories.map(s=><a class="news-card" href={'/news/'+s.slug+'/'}><div class="news-image"><img src={'/images/'+s.image} alt={s.title} width="650" height="440" loading="lazy"/></div><h3>{s.title}</h3><span class="news-meta">News, Projects</span><p>{s.text}</p></a>)}<a class="news-card" href="/about/"><div class="news-image"><img src="/images/factory.jpg" alt="Gewabin production base" width="650" height="440" loading="lazy"/></div><h3>Jiangsu Gewabin Heat Technology Co., Ltd</h3><span class="news-meta">Company</span><p>{company.philosophy}</p></a></div></section>
 <section class="spx-locations"><div class="wrap"><h2><svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m2 7 6-3 8 3 6-3v16l-6 3-8-3-6 3V7ZM8 4v16M16 7v16"/></svg> Contact Gewabin</h2><div class="spx-location-cards"><div><h3>Yixing, Wuxi, China ↗</h3><p>{company.address}</p></div><div><h3>Talk to Gewabin</h3><a href="tel:+8651087852861">☎ {company.phone}</a><a href="tel:+8613867612832">☎ {company.mobile}</a></div><div><h3>Product Inquiry</h3><a href={'mailto:'+company.email}>✉ {company.email}</a><a href="/contact/">Contact Us ↗</a></div></div><div class="spx-location-detail"><div><h3>Jiangsu Gewabin Heat Technology Co., Ltd</h3><p>Yixing District, Wuxi, Jiangsu Province, China</p><a href="https://www.google.com/maps/search/?api=1&query=Wanshi+Town+Yixing+Wuxi+Jiangsu+China" target="_blank" rel="noopener noreferrer">View Yixing area on map ↗</a></div><img src="/images/factory.jpg" alt="Gewabin manufacturing base" width="680" height="450" loading="lazy"/></div></div></section>
 <ContactBand title="Find Your Cooling Equipment"/>
 <script>
 const slides=[...document.querySelectorAll<HTMLElement>('[data-slide]')],dots=[...document.querySelectorAll<HTMLButtonElement>('[data-dot]')];let current=0,paused=matchMedia('(prefers-reduced-motion: reduce)').matches;const pause=document.querySelector<HTMLButtonElement>('.slide-pause');
 function show(n:number){current=(n+slides.length)%slides.length;slides.forEach((s,i)=>s.hidden=i!==current);dots.forEach((d,i)=>d.setAttribute('aria-pressed',String(i===current)));}
 function updatePause(){pause?.setAttribute('aria-pressed',String(paused));pause?.setAttribute('aria-label',paused?'Play slideshow':'Pause slideshow');if(pause)pause.textContent=paused?'▷':'Ⅱ';}
 dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);paused=true;updatePause();}));document.querySelector('.slide-prev')?.addEventListener('click',()=>{show(current-1);paused=true;updatePause();});document.querySelector('.slide-next')?.addEventListener('click',()=>{show(current+1);paused=true;updatePause();});pause?.addEventListener('click',()=>{paused=!paused;updatePause();});setInterval(()=>{if(!paused&&!document.hidden&&!document.querySelector('.spx-hero')?.matches(':hover, :focus-within'))show(current+1);},7000);updatePause();
 document.querySelector('.spx-play')?.addEventListener('click',()=>{const frame=document.createElement('iframe');frame.src='https://www.youtube-nocookie.com/embed/4irPZt6UlNA?autoplay=1';frame.title='Gewabin factory and workshop';frame.allow='autoplay; encrypted-media; picture-in-picture';frame.allowFullscreen=true;document.querySelector('#factory-video')!.replaceChildren(frame);document.querySelector<HTMLElement>('.video-fallback')!.hidden=false;});
 </script>
</Layout>
