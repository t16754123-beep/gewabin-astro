---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import {videos} from '../../data/extended';
---
<Layout title="Video Library"><PageHero title="Video Library" eyebrow="GEWABIN ON VIDEO" description="Watch official Gewabin factory and application videos." parent={{title:'Resource Library',href:'/library/'}}/><section class="section wrap video-library"><p class="resource-intro">Videos load from YouTube when you choose to play them. You can also open each video on YouTube.</p>{videos.map(v=><article class="video-entry" id={'video-'+v.id}><div class="video-player" data-video={v.id}><img src={'/images/'+v.image} alt={v.title} width="900" height="500" loading="lazy"/><button class="video-play-small" aria-label={'Play '+v.title}>▷ <span>Play video</span></button></div><div><span class="eyebrow">OFFICIAL GEWABIN VIDEO</span><h2>{v.title}</h2><p>{v.description}</p><a class="text-link" href={'https://www.youtube.com/watch?v='+v.id} target="_blank" rel="noopener noreferrer">Watch on YouTube <span>↗</span></a></div></article>)}<a class="source-link" href="https://www.gwbrefrigeration.com/video" target="_blank" rel="noopener noreferrer">Gewabin official video source ↗</a></section><script>document.querySelectorAll<HTMLElement>('[data-video]').forEach(player=>player.querySelector('button')?.addEventListener('click',()=>{const frame=document.createElement('iframe');frame.src='https://www.youtube-nocookie.com/embed/'+player.dataset.video+'?autoplay=1';frame.title=player.querySelector('img')?.alt||'Gewabin video';frame.allow='autoplay; encrypted-media; picture-in-picture';frame.allowFullscreen=true;player.replaceChildren(frame);}));</script></Layout>
