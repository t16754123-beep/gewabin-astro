---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import {resources} from '../../data/site';
---
<Layout title="Resource Library" description="Search Gewabin product information, technical reading and official videos."><PageHero title="Resource Library" description="Find product information, technical reading and official Gewabin videos." eyebrow="KNOWLEDGE & RESOURCES"/><section class="section wrap"><div class="resource-intro"><p>Read the guides online, explore product details or watch a factory video. For project-specific drawings and equipment documentation, <a href="/contact/?topic=Technical%20documentation">contact Gewabin</a>.</p></div><div class="catalog-tools"><div class="filters" aria-label="Resource type">{['All','Guide','Product','Video'].map((type,i)=><button class="filter" data-resource-filter={type} aria-pressed={i===0}>{type==='All'?'All resources':type+'s'}</button>)}</div><label class="resource-search-label"><span class="sr-only">Search library</span><input type="search" class="catalog-search" id="resource-search" placeholder="Search resources…"/></label></div><p class="result-count" aria-live="polite"></p><div class="resource-list">{resources.map(r=><a class="resource-item" href={r.href} data-resource-type={r.type} data-resource-search={(r.title+' '+r.description).toLowerCase()}><span class="resource-kind">{r.type}</span><div><h2>{r.title}</h2><p>{r.description}</p></div><span class="resource-arrow" aria-hidden="true">→</span></a>)}</div><div class="empty-results" hidden><h2>No resources found</h2><p>Try a broader keyword or change the resource type.</p><button class="btn" id="reset-resources">Reset search →</button></div></section><script>
 const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-resource-filter]')],rows=[...document.querySelectorAll<HTMLElement>('[data-resource-type]')],input=document.querySelector<HTMLInputElement>('#resource-search')!,empty=document.querySelector<HTMLElement>('.empty-results')!;let type='All';function update(){let n=0;const q=input.value.trim().toLowerCase();rows.forEach(row=>{row.hidden=!(type==='All'||row.dataset.resourceType===type)||!row.dataset.resourceSearch!.includes(q);if(!row.hidden)n++;});filters.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.resourceFilter===type)));document.querySelector('.result-count')!.textContent=`${n} resources`;empty.hidden=n>0;}filters.forEach(b=>b.addEventListener('click',()=>{type=b.dataset.resourceFilter!;update();}));input.addEventListener('input',update);document.querySelector('#reset-resources')?.addEventListener('click',()=>{type='All';input.value='';update();input.focus();});update();
 </script></Layout>
