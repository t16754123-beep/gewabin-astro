---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import {company} from '../data/content';
---
<Layout title="About Us">
 <section class="page-banner"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a><span>/</span><span>About Us</span></div><span class="eyebrow">JIANGSU GEWABIN HEAT TECHNOLOGY</span><h1>Integrity. Efficiency.<br/>Practicality.</h1></div></section>
 <section class="section wrap"><div class="about-grid"><div><span class="eyebrow">OUR COMPANY</span><h2>Refrigeration equipment.<br/>Made by Gewabin.</h2><p>{company.intro}</p><p>{company.about}</p><p>{company.philosophy}</p></div><img src="/images/factory.jpg" alt="Jiangsu Gewabin manufacturing base in Yixing" width="700" height="500"/></div><div class="stat-grid"><div><strong>2017</strong><span>Company established</span></div><div><strong>15,000 m²</strong><span>Main production base</span></div><div><strong>Yixing</strong><span>Jiangsu Province, China</span></div></div><a class="source-link" href={company.source} target="_blank" rel="noopener noreferrer">Gewabin company profile ↗</a></section>
 <section class="feature-section" id="service"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">CAPABILITIES & SERVICE</span><h2>From your requirements<br/>to your equipment.</h2></div></div><div class="service-grid"><article><span class="eyebrow">01 / TECHNICAL TEAM</span><h3>Product selection</h3><p>Technical proposals and CAD drawings support the selection of suitable refrigeration equipment.</p></article><article><span class="eyebrow">02 / CUSTOMIZATION</span><h3>Designed for your project</h3><p>Gewabin provides customized products, processing services and OEM solutions.</p></article><article><span class="eyebrow">03 / AFTER-SALES</span><h3>Installation support</h3><p>Instruction booklets and experienced technical personnel support installation and commissioning.</p></article></div><a class="source-link" href="https://www.gwbrefrigeration.com/evaporative-condenser/counter-flow-evaporative-condenser/counter-flow-type-evaporative-condenser.html" target="_blank" rel="noopener noreferrer">Gewabin service information ↗</a></div></section>
 <section class="section wrap"><div class="about-grid"><img src="/images/production.jpg" alt="Gewabin equipment production process" width="800" height="600" loading="lazy"/><div><span class="eyebrow">OUR FACTORY</span><h2>Manufacturing<br/>& technology.</h2><p>Gewabin uses CNC machine tools and standardized production process management to manufacture refrigeration equipment.</p><p>Products serve refrigeration, energy, chemical processing, metallurgy, petroleum, food and beverage, electronics and other industrial applications.</p><a class="text-link" href="/products/">Explore our products <span>→</span></a></div></div></section>
 <ContactBand/>
</Layout>
