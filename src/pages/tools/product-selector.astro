---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import {products} from '../../data/content';
---
<Layout title="Product Family Selector"><PageHero title="Product Family Selector" description="Identify a product family to discuss with Gewabin, then send a project brief." eyebrow="PROJECT TOOLS" parent={{title:'Tools',href:'/tools/'}}/><section class="section wrap selector-layout"><form class="selector-form" id="family-selector"><h2>Tell us what you need.</h2><label for="selector-duty">What is the equipment required to do?<select id="selector-duty" required><option value="">Choose a duty</option><option value="condensers">Condense refrigerant</option><option value="towers">Cool a process fluid in a closed circuit</option><option value="parts">Supply or replace a component</option></select></label><label for="selector-application">Application<select id="selector-application"><option>Not yet specified</option><option>Cold storage / refrigeration</option><option>Food / beverage / ice making</option><option>Industrial process</option><option>Building / HVAC</option><option>Data center</option><option>Other</option></select></label><label for="selector-notes">Project notes<textarea id="selector-notes" rows="4" maxlength="1200" placeholder="Operating conditions, available space, or equipment details…"></textarea></label><button class="btn" type="submit">Find a product family →</button><button class="selector-reset" type="reset">Reset</button><p class="form-note">This tool groups products by their stated purpose. It does not calculate capacity or validate equipment selection. Gewabin must confirm the final configuration.</p></form><div class="selector-output"><div id="selector-start"><span class="eyebrow">START WITH YOUR APPLICATION</span><h2>Three product families.<br/>One clear starting point.</h2><p>Choose a duty to see relevant equipment and prepare an inquiry.</p><img src="/images/counter-flow.jpg" alt="Gewabin evaporative condenser" width="650" height="450"/></div><div id="selector-results" hidden><h2 id="selector-heading" tabindex="-1">Suggested product family</h2><p class="selector-status" role="status" aria-live="polite"></p><div class="selector-products">{products.filter(p=>p.slug!=='refrigeration-heat-exchanger-parts').map(p=><a class="selector-product" href={'/products/'+p.slug+'/'} data-selector-family={p.category} data-selector-name={p.name}><img src={'/images/'+p.image} alt={p.name} width="200" height="170" loading="lazy"/><div><h3>{p.name}</h3><span>View product →</span></div></a>)}</div><a id="selector-inquiry" class="btn" href="/contact/">Prepare an inquiry →</a></div></div></section><script>
 const form=document.querySelector<HTMLFormElement>('#family-selector')!,duty=document.querySelector<HTMLSelectElement>('#selector-duty')!,application=document.querySelector<HTMLSelectElement>('#selector-application')!,notes=document.querySelector<HTMLTextAreaElement>('#selector-notes')!,start=document.querySelector<HTMLElement>('#selector-start')!,output=document.querySelector<HTMLElement>('#selector-results')!,items=[...document.querySelectorAll<HTMLElement>('[data-selector-family]')];form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const family=duty.value;let count=0;items.forEach(item=>{item.hidden=item.dataset.selectorFamily!==family;if(!item.hidden)count++;});start.hidden=true;output.hidden=false;document.querySelector('.selector-status')!.textContent=`${count} relevant products. Final selection requires a technical review.`;const url=new URL('/contact/',location.origin);url.searchParams.set('product','General inquiry');url.searchParams.set('topic','Product family: '+duty.selectedOptions[0].text);url.searchParams.set('requirements',`Duty: ${duty.selectedOptions[0].text}\nApplication: ${application.value}\n${notes.value}`);document.querySelector<HTMLAnchorElement>('#selector-inquiry')!.href=url.pathname+url.search;document.querySelector<HTMLElement>('#selector-heading')!.focus();});form.addEventListener('reset',()=>{start.hidden=false;output.hidden=true;});
 </script></Layout>
