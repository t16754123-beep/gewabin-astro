---
import Layout from '../layouts/Layout.astro';
import { company,products } from '../data/content';
---
<Layout title="Contact Us">
 <section class="page-banner"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a><span>/</span><span>Contact Us</span></div><span class="eyebrow">CONTACT GEWABIN</span><h1>Let's talk about<br/>your cooling requirements.</h1></div></section>
 <section class="section wrap contact-grid"><div class="contact-details"><h2>Get in touch.</h2><div class="contact-item"><span>EMAIL</span><a href={'mailto:'+company.email}>{company.email}</a></div><div class="contact-item"><span>TELEPHONE / MOBILE</span><a href="tel:+8651087852861">{company.phone}</a><br/><a href="tel:+8613867612832">{company.mobile}</a></div><div class="contact-item"><span>MANUFACTURING BASE</span><p>{company.address}</p></div><div class="contact-item"><span>WHATSAPP</span><a href="https://wa.me/8613867612832" target="_blank" rel="noopener noreferrer">Chat with Gewabin ↗</a></div></div>
 <form class="inquiry-form" id="inquiry-form"><h2>Product inquiry</h2><p class="form-note">Fill in your requirements, then open your email app to send your inquiry to Gewabin.</p><div class="form-grid"><label>Your name *<input name="name" autocomplete="name" required maxlength="100"/></label><label>Email address *<input name="email" type="email" autocomplete="email" required maxlength="200"/></label><label>Company<input name="company" autocomplete="organization" maxlength="200"/></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" maxlength="60"/></label></div><label>Product of interest<select name="product" id="inquiry-product"><option value="General inquiry">General inquiry</option>{products.map(p=><option value={p.name}>{p.name}</option>)}</select></label><label>Your requirements *<textarea name="message" required maxlength="5000" placeholder="Tell us about your application and cooling requirements…"></textarea></label><p class="form-note">This form opens your email app. Please review and send the email there. You can also email <a class="text-link" href={'mailto:'+company.email}>{company.email}</a> directly.</p><button class="btn" type="submit">Open email app <span>↗</span></button><p class="form-status" role="status" aria-live="polite"></p></form>
 </section>
 <script>
 const form=document.querySelector<HTMLFormElement>('#inquiry-form')!,select=document.querySelector<HTMLSelectElement>('#inquiry-product')!;
 const product=new URLSearchParams(location.search).get('product');if(product&&[...select.options].some(o=>o.value===product))select.value=product;
 form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const d=new FormData(form);const body=`Name: ${d.get('name')}\nEmail: ${d.get('email')}\nCompany: ${d.get('company')}\nPhone: ${d.get('phone')}\nProduct: ${d.get('product')}\n\nRequirements:\n${d.get('message')}`;location.href='mailto:gwbalice0818@gmail.com?subject='+encodeURIComponent('Product inquiry: '+d.get('product'))+'&body='+encodeURIComponent(body);document.querySelector('.form-status')!.textContent='Your email app has been requested. Review the inquiry and press Send in your email app. If it does not open, email gwbalice0818@gmail.com directly.';});
 </script>
</Layout>
