---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ContactBand from '../../components/ContactBand.astro';
import { products } from '../../data/content';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product:p}=Astro.props;
---
<Layout title={p.name} description={p.description}>
 <section class="page-banner"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Products</a></div><span class="eyebrow">{p.series}</span><h1>{p.name}</h1></div></section>
 <section class="section wrap detail-grid"><div class="detail-image"><img src={'/images/'+p.image} alt={p.name} width="650" height="600"/></div><div class="detail-copy"><span class="eyebrow">PRODUCT OVERVIEW</span><h2>{p.name}</h2><p>{p.description}</p><h3>Features</h3><ul>{p.features.map(f=><li>{f}</li>)}</ul><h3>Product information</h3><table class="spec-table"><tbody>{p.specs.map(([key,val])=><tr><th scope="row">{key}</th><td>{val}</td></tr>)}</tbody></table><a href={'/contact/?product='+encodeURIComponent(p.name)} class="btn">Request product information <span>↗</span></a><br/><a class="source-link" href={p.source} target="_blank" rel="noopener noreferrer">Original Gewabin product information ↗</a></div></section>
 <section class="section related-section"><div class="wrap"><div class="section-heading"><h2>Explore more products.</h2><a class="text-link" href="/products/">All products <span>→</span></a></div><div class="product-grid">{products.filter(x=>x.slug!==p.slug).slice(0,3).map(product=><ProductCard product={product}/>)}</div></div></section>
 <ContactBand/>
</Layout>
