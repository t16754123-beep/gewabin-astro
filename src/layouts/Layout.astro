---
import { company, categories } from '../data/content';
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/reference.css';
const {title='Evaporative Cooling Solutions', description=company.intro} = Astro.props;
const path=Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
 <title>{title} | Gewabin</title><meta name="description" content={description}/>
 <meta name="theme-color" content="#20357d"/><link rel="icon" type="image/png" href="/images/gewabin-logo.png"/>
</head>
<body>
 <a href="#main" class="skip">Skip to content</a>
 <header class="site-header">
  <div class="header-inner wrap">
   <a class="brand" href="/" aria-label="Gewabin home"><img src="/images/gewabin-logo.png" alt="Gewabin 格瓦宾" width="170" height="84"/></a>
   <div class="header-actions"><button class="desktop-menu-toggle" aria-expanded="false" aria-controls="desktop-menu">Menu <span>⌄</span></button><a class="quote-btn" href="/contact/">Get A Quote</a><a class="contact-header" href="/contact/">Contact Us</a><span class="header-language" lang="en">EN <span>⌄</span></span><button class="icon-btn search-toggle" aria-label="Search products" aria-expanded="false"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button><button class="menu-toggle icon-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button></div>
  </div>
  <nav id="desktop-menu" class="reference-menu" hidden aria-label="Main navigation"><div class="wrap"><div><h2>Products</h2>{categories.map(c=><a href={'/products/?category='+c.id}>{c.name}</a>)}<a href="/products/">All Products</a></div><div><h2>About</h2><a href="/about/">About Us</a><a href="/about/#service">Our Service</a><a href="/contact/">Contact Us</a></div><div><h2>News & Projects</h2><a href="/news/">News Center</a><a href="/news/ice-making-project-malaysia/">Ice Making Project in Malaysia</a><a href="/news/fruit-preservation-warehouse/">Fruit Preservation Warehouse</a></div></div></nav>
  <form class="header-search wrap" hidden action="/products/"><label for="header-q">Find a product</label><input id="header-q" name="q" placeholder="Search condensers, cooling towers, parts…" required/><button class="btn" type="submit">Search →</button></form>
  <nav id="mobile-menu" class="mobile-menu" hidden aria-label="Mobile navigation"><a href="/products/">Products</a><a href="/about/">About Us</a><a href="/news/">News & Projects</a><a href="/about/#service">Service</a><a href="/contact/">Contact Us</a></nav>
 </header>
 <main id="main"><slot/></main>
 <footer>
  <div class="wrap footer-grid">
   <div class="footer-brand"><a href="/" aria-label="Gewabin home"><img src="/images/gewabin-logo.png" alt="Gewabin 格瓦宾" width="170" height="84" loading="lazy"/></a><p>{company.philosophy}</p></div>
   <div><h2>Explore</h2><a href="/about/">About Us</a><a href="/products/">Products</a><a href="/news/">News & Projects</a><a href="/about/#service">Service</a></div>
   <div><h2>Products</h2>{categories.map(c=><a href={'/products/?category='+c.id}>{c.name}</a>)}</div>
   <div><h2>Contact Us</h2><a href={'tel:'+company.mobile.replaceAll(' ','')}>{company.mobile}</a><a href={'mailto:'+company.email}>{company.email}</a><p>{company.address}</p></div>
  </div>
  <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} {company.name}</span><span>GEWABIN · HEAT EXCHANGE TECHNOLOGY</span></div>
 </footer>
 <script>
 const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');
 const panel=document.querySelector<HTMLElement>('#mobile-menu');
 menu?.addEventListener('click',()=>{if(!panel)return;const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'Close menu':'Open menu');panel.hidden=!open;});
 const search=document.querySelector<HTMLButtonElement>('.search-toggle');
 const searchPanel=document.querySelector<HTMLFormElement>('.header-search');
 const desktopMenu=document.querySelector<HTMLButtonElement>('.desktop-menu-toggle'),desktopPanel=document.querySelector<HTMLElement>('#desktop-menu');
 desktopMenu?.addEventListener('click',()=>{if(!desktopPanel)return;desktopPanel.hidden=!desktopPanel.hidden;desktopMenu.setAttribute('aria-expanded',String(!desktopPanel.hidden));});
 search?.addEventListener('click',()=>{if(!searchPanel)return;searchPanel.hidden=!searchPanel.hidden;search.setAttribute('aria-expanded',String(!searchPanel.hidden));if(!searchPanel.hidden) document.querySelector<HTMLInputElement>('#header-q')?.focus();});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(panel)panel.hidden=true;menu?.setAttribute('aria-expanded','false');if(searchPanel)searchPanel.hidden=true;search?.setAttribute('aria-expanded','false');if(desktopPanel)desktopPanel.hidden=true;desktopMenu?.setAttribute('aria-expanded','false');}});
 </script>
</body>
</html>
